# MySQL / MariaDB connection. The default matches the docker-compose mysql service.
# In production (e.g. cPanel) use the database user you created: mysql://USER:PASSWORD@localhost:3306/DBNAME
DATABASE_URL=mysql://root:onset-root@127.0.0.1:23307/onset_launch

# Public URL of the deployed site. Used for metadata, Open Graph and the launch email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Analytics are off when unset.
NEXT_PUBLIC_GA_ID=

# Password for the private waitlist dashboard at /waitlist-lists. Use a long random value.
WAITLIST_ADMIN_PASSWORD=

# Outgoing email (waitlist confirmations and the launch email), sent through the
# cPanel mailbox's SMTP server. Leave SMTP_HOST empty to only log emails locally.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Onset <hello@onset.et>"
MAIL_REPLY_TO=hello@onset.et
